POSTGRES_DB=video_platform
POSTGRES_USER=video
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433
REDIS_PORT=6380
OLLAMA_HOST_PORT=11434
DATABASE_URL=postgresql+psycopg://video:change-me-for-local-development@localhost:5433/video_platform
REDIS_URL=redis://localhost:6380/0
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600
OLLAMA_CHAT_MODEL=gemma4:e2b-it-qat
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
REMEDIATION_ENABLED=false
KUBERNETES_API_URL=
KUBERNETES_BEARER_TOKEN=
KUBERNETES_CA_FILE=
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=

# Video task observation (enable after additive schema setup)
VIDEO_METRICS_ENABLED=false
VIDEO_METRICS_QUEUE=celery
VIDEO_METRICS_PORT=9108

# Dedicated v2 AIOps app: tokens must be distinct, >=32 random characters.
# Leave disabled on the existing video API/database.
AIOPS_ENABLED=false
AIOPS_OPERATOR_TOKEN=
AIOPS_WEBHOOK_TOKEN=
AIOPS_ALLOWED_NAMESPACES=video-platform
AIOPS_TOOLS_ENABLED=false
AIOPS_LOKI_URL=http://p1-loki.monitoring.svc.cluster.local:3100
KNOWLEDGE_VECTORS_ENABLED=false
KNOWLEDGE_EMBEDDING_PROVIDER=ollama
KNOWLEDGE_EMBEDDING_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_REVISION=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_TIMEOUT_SECONDS=30

# Hypothesis v2 process configuration (separate control DB / generated K8s Secrets).
AIOPS_GRAPH_ENABLED=false
AIOPS_MODEL_PROVIDER=ollama
AIOPS_MODEL_NAME=gemma4:e2b-it-qat
AIOPS_MODEL_URL=https://api.openai.com/v1
AIOPS_MODEL_API_KEY=
AIOPS_MODEL_TIMEOUT_SECONDS=180
AIOPS_MODEL_CONTEXT_TOKENS=16384
AIOPS_APPROVAL_ENABLED=false
AIOPS_APPROVAL_TTL_SECONDS=600
# REMEDIATION_ENABLED must remain false until an operator explicitly enables original-video review.

# Original video platform integration; installer enables these with separate private credentials.
AIOPS_VIDEO_ENABLED=false
AIOPS_VIDEO_DEMO_ENABLED=false
AIOPS_VIDEO_READER_TOKEN=
AIOPS_VIDEO_REPAIR_TOKEN=
AIOPS_VIDEO_SCAN_SINCE=

# Only hypothesis-v2 is scheduled; this flag controls repair proposals.
AIOPS_HYPOTHESIS_REMEDIATION_ENABLED=false
