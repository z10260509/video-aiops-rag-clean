# Exact base of the running AIOps control DB; retain PostgreSQL version and PVC compatibility.
FROM postgres:16@sha256:ca0bd484cb98bf4b24eb1010e73fb3fcbd6714d240fbc1a10eea5b7dbecb641d AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        postgresql-server-dev-16 \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && git checkout f37c13f68b57d2c3472b2214fbcff699d6d34876 \
    && make OPTFLAGS='' \
    && make install
FROM postgres:16@sha256:ca0bd484cb98bf4b24eb1010e73fb3fcbd6714d240fbc1a10eea5b7dbecb641d
COPY --from=builder /usr/lib/postgresql/16/lib/vector.so /usr/lib/postgresql/16/lib/vector.so
COPY --from=builder /usr/share/postgresql/16/extension/vector* /usr/share/postgresql/16/extension/
LABEL aiops.pgvector.version="0.8.7" aiops.pgvector.revision="f37c13f68b57d2c3472b2214fbcff699d6d34876"
